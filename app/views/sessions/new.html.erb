<h1 class="text-center mt-4">Log In</h1>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-10">
      <%= form_with(scope: :session, url: login_path, class: "shadow p-3 mb-3 bg-info rounded", local: true) do |form| %>

        <div class="form-group row">
          <%= form.label :email, class: "col-2 col-form-lable text-light" %>
          <div class="col-10">
            <%= form.email_field :email, class: "form-control shadow mb-3 rounded", placeholder: "Enter your email address" %>
          </div>
        </div>

        <div class="form-group row">
          <%= form.label :password, class: "col-2 col-form-lable text-light" %>
          <div class="col-10">
            <%= form.password_field :password, class: "form-control shadow mb-3 rounded", placeholder: "Enter your password" %>
          </div>
      </div>

        <div class="form-group row-1 justify-content-center">
          <%= form.submit 'Log in', class: "btn btn-outline-light btn-lg" %>
        </div>
      <% end %>
      <div class="mb-3">
        <%= link_to "Back to articles", articles_path, class: "text-info" %>
      </div>
    </div>
  </div>
</div>