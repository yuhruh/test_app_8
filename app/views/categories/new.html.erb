<h1 class="text-center mt-4">Create a new category</h1>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-10">
      <%= render 'shared/errors', obj: @category %>
      <%= form_with(model: @category, class: "shadow p-3 mb-3 bg-info rounded", local: true) do |form| %>
        <div class="form-group row">
          <%= form.label :name, "Category name", class: "col-2 col-form-lable text-light" %>
          <div class="col-10">
            <%= form.text_field :name, class: "form-contol shadow mb-3 rounded", placeholder: "Enter a name" %>
          </div>
        </div>

        <div class="form-group row-1 justify-content-center">
          <%= form.submit class: "btn btn-outline-light btn-lg" %>
        </div>
      <% end %>
      <div class="mb-3">
        <%= link_to "Back to articles", articles_path, class: "text-info" %>
      </div>
    </div>
  </div>
</div>